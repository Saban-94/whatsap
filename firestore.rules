rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User validation
    function isValidUser(data) {
      return data.keys().hasAll(['displayName']) &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (!data.keys().hasAny(['photoURL']) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
             (!data.keys().hasAny(['isTyping']) || data.isTyping is bool);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isValidUser(request.resource.data);
    }

    // Chat validation
    function isValidChat(data) {
      return data.participants is list && data.participants.size() <= 10;
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants && isValidChat(request.resource.data);
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt', 'title']) &&
        isValidChat(request.resource.data)
      );
    }

    // Message validation
    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'text', 'status', 'createdAt', 'type']) &&
             (data.senderId == request.auth.uid || data.senderId == 'noa') &&
             data.text is string && data.text.size() <= 4096 &&
             data.status in ['sent', 'read'] &&
             data.type in ['text', 'file', 'audio'] &&
             (!data.keys().hasAny(['fileName']) || (data.fileName is string && data.fileName.size() <= 256)) &&
             (!data.keys().hasAny(['fileUrl']) || (data.fileUrl is string && data.fileUrl.size() <= 2048)) &&
             (!data.keys().hasAny(['duration']) || (data.duration is number || data.duration is int)) &&
             data.createdAt == request.time;
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      allow create: if isSignedIn() && 
                    request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                    isValidMessage(request.resource.data);
      allow update: if isSignedIn() && 
                    request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
                    request.resource.data.status == 'read';
    }
  }
}
